{
  "feature": "env",
  "version": 1,
  "multi_instance": true,
  "description": "Environmental sensor (e.g. BME280) producing one slow stream named after the instance. Optional on the vibration logger: present only if the sensor is fitted.",
  "config": {
    "interval_s": { "type": "number", "default": 1, "min": 0.1, "max": 3600, "unit": "s", "applies": "new_file" }
  },
  "status": {
    "ok": { "type": "boolean" },
    "temperature_c": { "type": "number", "unit": "degC" },
    "humidity_pct": { "type": "number", "unit": "%RH" }
  },
  "commands": {},
  "streams": [
    { "name": "{instance}", "rate_hz": "1/{config.interval_s}",
      "channels": [ { "name": "temperature", "unit": "degC" }, { "name": "humidity", "unit": "%RH" }, { "name": "pressure", "unit": "hPa" } ] }
  ],
  "events": {
    "sensor_error": "The sensor stopped responding."
  }
}
