<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the broker as _mqtt._tcp so loggers find it by mDNS (MQTT.md, Network).
     Installed as /etc/avahi/services/mqtt.service. -->
<service-group>
  <name replace-wildcards="yes">Logger master MQTT on %h</name>
  <service>
    <type>_mqtt._tcp</type>
    <port>1883</port>
  </service>
</service-group>
